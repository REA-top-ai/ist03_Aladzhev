a = input("Введите количество монет по 5 копеек: ")
b = input("Введите количество монет по 10 копеек: ")
c = input("Введите количество монет по 50 копеек: ")
a = int(a)
b = int(b)
c = int(c)
summ = (a*5 + b*10 + c*50) / 100
if summ == 1:
    print("Победа")
elif summ < 1:
    print("Сумма меньше рубля")
elif summ > 1:
    print("Сумма больше рубля")
